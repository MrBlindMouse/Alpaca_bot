VERSION=PAPER
PAPER_KEY=your_paper_key
PAPER_SECRET=your_paper_secret
API_KEY=your_live_key
API_SECRET=your_live_secret
MARGIN=0.05

# Remote webhook (default off). Posts trade fills, day_end, and WARNING+ logs.
# Leave REMOTE_WEBHOOK_SECRET empty only for trusted networks (unsigned POSTs).
REMOTE_LOGGING_ENABLED=false
REMOTE_BASE_URL=
REMOTE_WEBHOOK_SECRET=

# Standard logging
LOG_LEVEL=INFO
LOG_FILE=

# Optional: reject market orders if price moved too much since last snapshot (default off)
SLIPPAGE_GUARD_ENABLED=false
MAX_SLIPPAGE_PCT=0.02

# Pause rebalance after consecutive API failures
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_BACKOFF_SECONDS=300

# Backtest (python -m backtest fetch|run|status)
BACKTEST_BAR_DB=data/bars.sqlite
BACKTEST_SYMBOLS_FILE=data/backtest_symbols.json
BACKTEST_TIMEFRAME=5Min
BACKTEST_FEED=iex
BACKTEST_ADJUSTMENT=all
BACKTEST_DATA_RPM=150
BACKTEST_SYMBOL_DELAY_MS=0
BACKTEST_START=
BACKTEST_END=
BACKTEST_INITIAL_CASH=100000
BACKTEST_TRADES_FILE=backtest_trades.jsonl
BACKTEST_EQUITY_FILE=backtest_equity.csv
BACKTEST_DECISIONS_FILE=backtest_decisions.jsonl
BACKTEST_LOG_FILE=backtest.log
BACKTEST_LOG_LEVEL=INFO
BACKTEST_COMPARISON_FILE=backtest_comparison.csv
BACKTEST_WEIGHTS_FILE=data/backtest_weights.json
BACKTEST_MARGINS=0.03,0.05,0.10
